#!/usr/bin/env python3

import sys
import difflib
import hashlib
import subprocess
import tempfile
import re
import argparse

RED="\033[31m"
GREEN="\033[32m"
RESET="\033[0m"

word_re=re.compile(r"[A-Za-z]+")
ansi_re=re.compile(r'\x1b\[[0-9;]*m')

def strip_ansi(s):
    return ansi_re.sub('', s)

# ----------------------------
# Markdown block parsing
# ----------------------------

def read_blocks(path):

    blocks=[]
    cur=[]

    with open(path) as f:
        for line in f:

            if line.startswith("#"):

                if cur:
                    blocks.append("".join(cur).strip())
                    cur=[]

            cur.append(line)

    if cur:
        blocks.append("".join(cur).strip())

    return [b for b in blocks if b.strip()]

# ----------------------------
# text helpers
# ----------------------------

def normalize_case(s,ignore_case):
    return s.lower() if ignore_case else s

def word_set(s,ignore_case):
    if ignore_case:
        s=s.lower()
    return set(w for w in word_re.findall(s))

def overlap(a,b):
    if not a or not b:
        return 0
    return len(a & b)/min(len(a),len(b))

# ----------------------------
# hashing
# ----------------------------

def norm(s,ignore_case):
    s=" ".join(s.split())
    if ignore_case:
        s=s.lower()
    return s

def hash_para(s,ignore_case):
    return hashlib.sha1(norm(s,ignore_case).encode()).hexdigest()

# ----------------------------
# similarity
# ----------------------------

def containment(a,b):
    sm=difflib.SequenceMatcher(None,a,b)
    l=max(m.size for m in sm.get_matching_blocks())
    return l/min(len(a),len(b))

def similarity(a,b):
    sm=difflib.SequenceMatcher(None,a,b)
    return max(sm.ratio(),containment(a,b))

# ----------------------------
# git word diff
# ----------------------------

def git_word_diff(a,b,ignore_case):

    if ignore_case:
        a_cmp=a.lower()
        b_cmp=b.lower()
    else:
        a_cmp=a
        b_cmp=b

    with tempfile.NamedTemporaryFile("w+") as fa, tempfile.NamedTemporaryFile("w+") as fb:

        fa.write(a_cmp+"\n")
        fb.write(b_cmp+"\n")
        fa.flush()
        fb.flush()

        r=subprocess.run(
            [
                "git",
                "diff",
                "--no-index",
                "--no-prefix",
                "--word-diff=color",
                "--word-diff-regex=\\w+",
                fa.name,
                fb.name
            ],
            capture_output=True,
            text=True
        )

    lines=r.stdout.splitlines()

    out=[]
    started=False

    for line in lines:

        clean=strip_ansi(line)

        if not started:
            if clean.startswith(("diff","index","---","+++","@@")):
                continue
            started=True

        out.append(line)

    return "\n".join(out)

# ----------------------------
# matching
# ----------------------------

def remove_exact(a,b,ignore_case):

    h={}
    for i,p in enumerate(a):
        h.setdefault(hash_para(p,ignore_case),[]).append(i)

    matches={}
    matched_a=set()

    for j,p in enumerate(b):

        key=hash_para(p,ignore_case)

        if key in h and h[key]:
            i=h[key].pop()
            matches[j]=(i,1.0)
            matched_a.add(i)

    return matches,matched_a


def match_blocks(a,b,matches,matched_a,ignore_case):

    wa=[word_set(p,ignore_case) for p in a]
    wb=[word_set(p,ignore_case) for p in b]

    pairs=[]

    for i,pa in enumerate(a):

        if i in matched_a:
            continue

        for j,pb in enumerate(b):

            if j in matches:
                continue

            if overlap(wa[i],wb[j])<0.35:
                continue

            pa_cmp=normalize_case(pa,ignore_case)
            pb_cmp=normalize_case(pb,ignore_case)

            s=similarity(pa_cmp,pb_cmp)

            if s>0.3:
                pairs.append((s,i,j))

    pairs.sort(reverse=True)

    for s,i,j in pairs:

        if i not in matched_a and j not in matches:
            matches[j]=(i,s)
            matched_a.add(i)

# ----------------------------
# printing helpers
# ----------------------------

def print_added(p):
    for line in p.splitlines():
        print(GREEN+line+RESET)

def print_deleted(p):
    for line in p.splitlines():
        print(RED+line+RESET)

# ----------------------------
# main diff
# ----------------------------

def run_diff(a_file,b_file,ignore_case,report_identical):

    a=read_blocks(a_file)
    b=read_blocks(b_file)

    if report_identical and norm("\n".join(a),ignore_case)==norm("\n".join(b),ignore_case):
        print("Files are identical.")
        return

    matches,matched_a=remove_exact(a,b,ignore_case)

    match_blocks(a,b,matches,matched_a,ignore_case)

    used_a=set(i for i,_ in matches.values())

    next_a=0

    added=deleted=modified=unchanged=0

    for j,pb in enumerate(b):

        if j not in matches:
            print_added(pb)
            added+=1
            continue

        i,score=matches[j]

        while next_a<i:
            if next_a not in used_a:
                print_deleted(a[next_a])
                deleted+=1
            next_a+=1

        pa=a[i]

        pa_cmp=normalize_case(pa,ignore_case)
        pb_cmp=normalize_case(pb,ignore_case)

        if pa_cmp==pb_cmp:
            unchanged+=1
            print(pa)
        else:
            modified+=1
            print(git_word_diff(pa,pb,ignore_case))

        next_a=i+1

    while next_a<len(a):
        if next_a not in used_a:
            print_deleted(a[next_a])
            deleted+=1
        next_a+=1

    print("\nSummary")
    print(f"unchanged: {unchanged}")
    print(f"modified : {modified}")
    print(f"added    : {added}")
    print(f"deleted  : {deleted}")

# ----------------------------
# CLI
# ----------------------------

def main():

    parser=argparse.ArgumentParser(
        prog="mddiff",
        description="Markdown-aware structural diff with block matching and word-level highlighting."
    )

    parser.add_argument("file_a", nargs="?")
    parser.add_argument("file_b", nargs="?")

    parser.add_argument(
        "-i","--ignore-case",
        action="store_true",
        help="ignore case differences"
    )

    parser.add_argument(
        "-s","--report-identical-files",
        action="store_true",
        help="report if files are identical"
    )

    args=parser.parse_args()

    if not args.file_a or not args.file_b:
        parser.print_help()
        sys.exit(0)

    run_diff(
        args.file_a,
        args.file_b,
        args.ignore_case,
        args.report_identical_files
    )

if __name__=="__main__":
    main()
