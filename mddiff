#!/usr/bin/env python3

import sys
import difflib
import hashlib
import subprocess
import tempfile
import re
import argparse

RED = "\033[31m"
GREEN = "\033[32m"
RESET = "\033[0m"

word_re = re.compile(r"[A-Za-z]+")
ansi_re = re.compile(r"\x1b\[[0-9;]*m")


def strip_ansi(s):
    return ansi_re.sub('', s)


# ----------------------------
# Markdown block parsing
# ----------------------------

def read_blocks(path):
    blocks = []
    cur = []

    with open(path) as f:
        for line in f:
            if line.startswith('#'):
                if cur:
                    blocks.append(''.join(cur).strip())
                    cur = []
            cur.append(line)

    if cur:
        blocks.append(''.join(cur).strip())

    return [b for b in blocks if b.strip()]


# ----------------------------
# Text helpers
# ----------------------------

def normalize_case(s, ignore_case):
    return s.lower() if ignore_case else s


def word_set(s, ignore_case):
    if ignore_case:
        s = s.lower()
    return set(word_re.findall(s))


def overlap(a, b):
    if not a or not b:
        return 0.0
    return len(a & b) / min(len(a), len(b))


# ----------------------------
# Hashing
# ----------------------------

def norm(s, ignore_case):
    s = ' '.join(s.split())
    if ignore_case:
        s = s.lower()
    return s


def hash_para(s, ignore_case):
    return hashlib.sha1(norm(s, ignore_case).encode()).hexdigest()


# ----------------------------
# Similarity
# ----------------------------

def containment(a, b):
    sm = difflib.SequenceMatcher(None, a, b)
    longest = max(m.size for m in sm.get_matching_blocks())
    return longest / min(len(a), len(b))


def similarity(a, b):
    sm = difflib.SequenceMatcher(None, a, b)
    return max(sm.ratio(), containment(a, b))


# ----------------------------
# Git word diff
# ----------------------------

def git_word_diff(a, b, ignore_case):
    if ignore_case:
        a_cmp = a.lower()
        b_cmp = b.lower()
    else:
        a_cmp = a
        b_cmp = b

    with tempfile.NamedTemporaryFile('w+') as fa, tempfile.NamedTemporaryFile('w+') as fb:
        fa.write(a_cmp + "\n")
        fb.write(b_cmp + "\n")
        fa.flush()
        fb.flush()

        r = subprocess.run(
            [
                'git',
                'diff',
                '--no-index',
                '--no-prefix',
                '--word-diff=color',
                "--word-diff-regex=\\w+",
                fa.name,
                fb.name,
            ],
            capture_output=True,
            text=True,
        )

    out = []
    in_body = False

    for line in r.stdout.splitlines():
        clean = strip_ansi(line)

        if not in_body:
            if clean.startswith('@@'):
                in_body = True
            continue

        out.append(line)

    return "\n".join(out)

# ----------------------------
# Matching
# ----------------------------

def remove_exact(a, b, ignore_case):
    h = {}
    for i, p in enumerate(a):
        h.setdefault(hash_para(p, ignore_case), []).append(i)

    matches = {}
    matched_a = set()

    for j, p in enumerate(b):
        key = hash_para(p, ignore_case)
        if key in h and h[key]:
            i = h[key].pop()
            matches[j] = (i, 1.0)
            matched_a.add(i)

    return matches, matched_a


def match_blocks(a, b, matches, matched_a, ignore_case, threshold):
    wa = [word_set(p, ignore_case) for p in a]
    wb = [word_set(p, ignore_case) for p in b]

    pairs = []

    for i, pa in enumerate(a):
        if i in matched_a:
            continue

        for j, pb in enumerate(b):
            if j in matches:
                continue

            if overlap(wa[i], wb[j]) < threshold:
                continue

            pa_cmp = normalize_case(pa, ignore_case)
            pb_cmp = normalize_case(pb, ignore_case)

            s = similarity(pa_cmp, pb_cmp)
            if s > 0.3:
                pairs.append((s, i, j))

    pairs.sort(reverse=True)

    for s, i, j in pairs:
        if i not in matched_a and j not in matches:
            matches[j] = (i, s)
            matched_a.add(i)


# ----------------------------
# Event construction
# ----------------------------

def build_events(a, b, matches, ignore_case):
    used_a = {i for i, _ in matches.values()}
    next_a = 0
    events = []

    for j, pb in enumerate(b):
        if j not in matches:
            events.append(('added', pb))
            continue

        i, _ = matches[j]

        while next_a < i:
            if next_a not in used_a:
                events.append(('deleted', a[next_a]))
            next_a += 1

        pa = a[i]

        if normalize_case(pa, ignore_case) == normalize_case(pb, ignore_case):
            events.append(('unchanged', pa))
        else:
            events.append(('modified', (pa, pb)))

        next_a = i + 1

    while next_a < len(a):
        if next_a not in used_a:
            events.append(('deleted', a[next_a]))
        next_a += 1

    return events


# ----------------------------
# Context filtering
# ----------------------------

def apply_context(events, context):
    change_indices = [i for i, (t, _) in enumerate(events) if t != 'unchanged']
    keep = set()

    if not change_indices:
        for i in range(min(context, len(events))):
            keep.add(i)
        for i in range(max(len(events) - context, 0), len(events)):
            keep.add(i)
    else:
        for i in change_indices:
            for j in range(i - context, i + context + 1):
                if 0 <= j < len(events):
                    keep.add(j)

    filtered = []
    i = 0

    while i < len(events):
        if i not in keep:
            filtered.append(('skip', None))
            while i < len(events) and i not in keep:
                i += 1
            continue

        filtered.append(events[i])
        i += 1

    return filtered


# ----------------------------
# Summary
# ----------------------------

def compute_summary(events):
    added = deleted = modified = unchanged = 0

    for t, _ in events:
        if t == 'added':
            added += 1
        elif t == 'deleted':
            deleted += 1
        elif t == 'modified':
            modified += 1
        elif t == 'unchanged':
            unchanged += 1

    return unchanged, modified, added, deleted


# ----------------------------
# Printing
# ----------------------------

def print_events(events, ignore_case):
    for t, data in events:
        if t == 'skip':
            print('...')
            continue

        if t == 'added':
            for l in data.splitlines():
                print(GREEN + l + RESET)

        elif t == 'deleted':
            for l in data.splitlines():
                print(RED + l + RESET)

        elif t == 'unchanged':
            print(data)

        elif t == 'modified':
            pa, pb = data
            print(git_word_diff(pa, pb, ignore_case))


# ----------------------------
# Main diff
# ----------------------------

def run_diff(a_file, b_file, ignore_case, report_identical, context, threshold, shortstat):
    a = read_blocks(a_file)
    b = read_blocks(b_file)

    if report_identical and norm("\n".join(a), ignore_case) == norm("\n".join(b), ignore_case):
        print('Files are identical.')
        return

    matches, matched_a = remove_exact(a, b, ignore_case)
    match_blocks(a, b, matches, matched_a, ignore_case, threshold)

    events = build_events(a, b, matches, ignore_case)
    summary = compute_summary(events)

    if context is not None:
        events = apply_context(events, context)

    if not shortstat:
        print_events(events, ignore_case)

    unchanged, modified, added, deleted = summary

    print("\nSummary")
    print(f"unchanged: {unchanged}")
    print(f"modified : {modified}")
    print(f"added    : {added}")
    print(f"deleted  : {deleted}")


# ----------------------------
# CLI
# ----------------------------

def main():
    parser = argparse.ArgumentParser()

    parser.add_argument("file_a", nargs="?")
    parser.add_argument("file_b", nargs="?")

    parser.add_argument("-i", "--ignore-case", action="store_true")
    parser.add_argument("-s", "--report-identical-files", action="store_true")

    parser.add_argument("-c", action="store_true", help="show context (default 3)")
    parser.add_argument("-C", "--context", type=int, help="context blocks")

    parser.add_argument(
        "--match-threshold",
        type=float,
        default=35.0,
        help="minimum word overlap percentage (default 35)",
    )

    parser.add_argument(
        "--shortstat",
        action="store_true",
        help="show only summary statistics",
    )

    args = parser.parse_args()

    if not args.file_a or not args.file_b:
        parser.print_help()
        sys.exit(0)

    context = None
    if args.c:
        context = 3
    if args.context is not None:
        context = args.context

    threshold = args.match_threshold / 100.0

    run_diff(
        args.file_a,
        args.file_b,
        args.ignore_case,
        args.report_identical_files,
        context,
        threshold,
        args.shortstat,
    )


if __name__ == "__main__":
    main()
